{
  "name": "ion-ide",
  "productName": "Ion IDE",
  "version": "0.9.7",
  "description": "An offline-first desktop IDE for writing and running your own code.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs dev",
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "build:baseline": "node scripts/build.mjs baseline",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:integrity": "node scripts/test-data-integrity.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:editor-session": "node scripts/test-editor-session.mjs && node scripts/test-editor-retention.mjs",
    "test:keyboard": "node scripts/test-keyboard.mjs",
    "test:java-tools": "node scripts/test-java-tools.mjs",
    "test:format": "node scripts/test-format-code.mjs",
    "test:workspace-search": "node scripts/test-workspace-search.mjs",
    "test:profile-export": "node scripts/test-profile-export.mjs",
    "test:large-editor": "node scripts/test-large-editor.mjs",
    "test:markdown": "node scripts/test-markdown-preview.mjs",
    "test:marketplace": "node scripts/test-learning-marketplace.mjs",
    "test:practice": "node scripts/test-practice-catalog.mjs",
    "test:starters": "node scripts/test-starter-code.mjs",
    "test:notebooks": "node scripts/test-notebook.mjs --edit",
    "test:window": "node scripts/test-window-startup.mjs",
    "test:onboarding": "node scripts/test-onboarding.mjs",
    "test:regression": "npm run typecheck && npm test && npm run build && npm run test:desktop && npm run test:window && npm run test:onboarding && node scripts/test-update-preferences.mjs && node scripts/test-update-lifecycle.mjs && node scripts/test-run-trust.mjs && npm run test:integrity && npm run test:recovery && npm run test:editor-session && npm run test:keyboard && npm run test:java-tools && npm run test:format && npm run test:workspace-search && npm run test:run-console && npm run test:native-projects && npm run test:terminal && npm run test:workspaces && npm run test:source-control && npm run test:project-suites && npm run test:learning-lens && npm run test:marketplace && npm run test:practice && npm run test:starters && npm run test:profile-export && npm run test:resources && npm run test:themes && npm run test:viewers && npm run test:large-editor && npm run test:notebooks && npm run test:markdown",
    "bench:desktop": "node scripts/benchmark.mjs",
    "bench:development": "node scripts/benchmark-development-workflows.mjs",
    "bench:java-tools": "node scripts/benchmark-java-tools.mjs",
    "bench:format": "node scripts/benchmark-format-code.mjs",
    "bench:onboarding": "node scripts/benchmark-onboarding.mjs",
    "install:mac": "npm run build && node scripts/install-mac.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:dmg": "npm run package:mac && node scripts/package-mac.mjs dmg",
    "package:win": "node scripts/package-win.mjs",
    "test:release:win": "node scripts/verify-windows-release.mjs",
    "test:workspaces": "node scripts/workspaces.mjs",
    "test:source-control": "node scripts/test-source-control.mjs",
    "test:git-security": "node scripts/test-git-configuration-race.mjs",
    "test:shutdown": "node scripts/test-shutdown-stability.mjs",
    "test:project-suites": "node scripts/test-project-suites.mjs",
    "test:resources": "node scripts/resource-lifecycle.mjs",
    "bench:resources": "node scripts/benchmark-resources.mjs",
    "bench:session": "node scripts/benchmark-session-lifecycle.mjs",
    "bench:editor-residency": "node scripts/benchmark-editor-residency.mjs",
    "bench:notebooks": "node scripts/benchmark-notebooks.mjs",
    "bench:markdown": "node scripts/benchmark-markdown-preview.mjs",
    "check:performance": "node scripts/check-performance-regression.mjs",
    "test:themes": "node scripts/themes.mjs",
    "test:navigation": "node scripts/test-project-navigation.mjs",
    "bench:themes": "node scripts/benchmark-theme-collection.mjs",
    "test:learning-lens": "node scripts/test-learning-lens.mjs",
    "bench:learning-lens": "node scripts/benchmark-learning-lens.mjs",
    "bench:marketplace": "node scripts/benchmark-learning-marketplace.mjs",
    "test:viewers": "node scripts/test-paged-viewer.mjs && node scripts/test-word-viewer.mjs && node scripts/test-table-viewer.mjs",
    "bench:viewers": "node scripts/benchmark-viewers.mjs",
    "test:run-console": "node scripts/test-run-console.mjs",
    "test:native-projects": "node scripts/test-native-projects.mjs",
    "bench:run-console": "node scripts/benchmark-run-console.mjs",
    "test:terminal": "node scripts/test-integrated-terminal.mjs",
    "bench:terminal": "node scripts/benchmark-integrated-terminal.mjs",
    "stats:live": "node scripts/sample-live-runtime.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "csv-parse": "7.0.3",
    "dompurify": "3.4.17",
    "marked": "14.0.0",
    "monaco-editor": "0.57.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sax": "1.6.1",
    "vscode-jsonrpc": "10.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sax": "1.2.7",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vscode/ripgrep": "1.18.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
